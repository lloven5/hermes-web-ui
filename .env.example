# Copy to .env in this directory (docker compose loads it automatically):
#   cp .env.example .env
#
# Also set the same API_SERVER_KEY in ./hermes_data/.env so agent, web-ui,
# and gateway-manager profile reads stay in sync.

# --- Users & permissions (must match: chown hermes_data to these IDs) ---
HERMES_UID=10000
HERMES_GID=10000

# --- API auth (development default; use a strong random value in production) ---
API_SERVER_KEY=hermes-compose-dev-only-replace-in-production

# --- Ports ---
PORT=3003
API_PORT=8642
DASHBOARD_PORT=9119

# --- Images (optional overrides) ---
# HERMES_AGENT_IMAGE=hermes-agent:v2
# WEBUI_IMAGE=hermes-web:v2

# --- Web UI ---
AUTH_DISABLED=true
# UPSTREAM=http://hermes-agent:8642

# --- Agent ---
HERMES_DASHBOARD=1
GATEWAY_ALLOW_ALL_USERS=true
